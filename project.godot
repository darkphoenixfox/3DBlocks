; 3D Blocks - hand-maintained project file (no editor needed).

config_version=5

[application]

config/name="3D Blocks"
config/icon="res://assets/icon.png"
config/description="VR block breaker in the style of Tilt Breaker."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
run/low_processor_mode=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=1

[gui]

theme/custom_font="res://assets/fonts/pinpixel.ttf"
theme/default_font_antialiasing=0

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="forward_plus"
rendering_device/driver.windows="d3d12"
rendering_device/fallback_to_vulkan=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[shader_globals]

eye_ball={
"type": "int",
"value": -1
}
eye_world={
"type": "int",
"value": -1
}

[xr]

openxr/enabled=false
openxr/enabled.quest=true
shaders/enabled=true
